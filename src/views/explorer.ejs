<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phuc_Data Explorer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .glass-panel {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .file-item:hover {
            background-color: rgba(243, 244, 246, 0.8);
            transform: translateY(-1px);
        }
        .file-item {
            transition: all 0.2s ease;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen p-4 md:p-8 text-gray-800 font-sans relative">
    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="fixed inset-0 z-[100] hidden bg-black/60 backdrop-blur-sm flex-col items-center justify-center text-white">
        <i class="fa-solid fa-circle-notch fa-spin text-5xl mb-4 text-indigo-400"></i>
        <h2 class="text-xl font-medium">Đang xử lý...</h2>
        <p class="text-sm text-gray-300 mt-2">Vui lòng chờ và không đóng trình duyệt</p>
    </div>

    <div class="max-w-5xl mx-auto glass-panel p-6">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6 border-b pb-4">
            <div>
                <h1 class="text-2xl font-bold text-indigo-700 flex items-center gap-2">
                    <i class="fa-solid fa-cloud"></i> Phuc_Data Explorer
                </h1>
                <p class="text-sm text-gray-500 mt-1">Quản lý kho dữ liệu cá nhân</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium bg-indigo-100 text-indigo-800 py-1 px-3 rounded-full">
                    <i class="fa-solid fa-user-shield mr-1"></i> <%= user?.email || 'Admin' %>
                </span>
            </div>
        </div>

        <!-- Controls -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4 bg-white p-4 rounded-lg shadow-sm border">
            <!-- Path Nav -->
            <div class="flex items-center overflow-x-auto whitespace-nowrap text-sm font-mono text-gray-600 bg-gray-50 px-3 py-2 rounded flex-1 w-full sm:w-auto">
                <span class="mr-2 text-indigo-500"><i class="fa-solid fa-folder-open"></i></span>
                <%= currentPath %>
            </div>

            <div class="flex gap-2 w-full sm:w-auto">
                <!-- Create Folder -->
                <form action="/explorer/mkdir" method="POST" class="flex">
                    <input type="hidden" name="currentPath" value="<%= currentPath %>">
                    <input type="text" name="folderName" placeholder="Thư mục mới" class="border border-gray-300 rounded-l px-3 py-1 text-sm focus:outline-none focus:border-indigo-500 w-32" required>
                    <button type="submit" class="bg-indigo-600 text-white px-3 py-1 rounded-r text-sm hover:bg-indigo-700 transition">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </form>

                <!-- Upload File -->
                <form action="/explorer/upload" method="POST" enctype="multipart/form-data" class="flex" id="uploadForm">
                    <input type="hidden" name="currentPath" value="<%= currentPath %>">
                    <label class="bg-green-600 text-white px-4 py-1 rounded text-sm hover:bg-green-700 transition cursor-pointer flex items-center gap-2">
                        <i class="fa-solid fa-upload"></i> Tải lên
                        <input type="file" name="file" class="hidden" onchange="document.getElementById('uploadForm').submit()">
                    </label>
                </form>
            </div>
        </div>

        <!-- File List -->
        <div class="bg-white rounded-lg shadow-sm border overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 text-gray-600 text-sm uppercase tracking-wider border-b">
                        <th class="p-4 w-12 text-center"></th>
                        <th class="p-4 font-medium">Tên file</th>
                        <th class="p-4 font-medium hidden md:table-cell">Kích thước</th>
                        <th class="p-4 font-medium hidden md:table-cell">Ngày sửa</th>
                        <th class="p-4 font-medium text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <!-- Up button -->
                    <% if (currentPath !== '/') { %>
                    <tr class="file-item cursor-pointer" onclick="window.location.href='/explorer?path=<%= encodeURIComponent(parentPath) %>'">
                        <td class="p-4 text-center text-indigo-400"><i class="fa-solid fa-level-up-alt fa-flip-horizontal"></i></td>
                        <td class="p-4 font-medium text-gray-700" colspan="4">.. (Lên thư mục cha)</td>
                    </tr>
                    <% } %>

                    <!-- Files -->
                    <% if (files.length === 0) { %>
                    <tr>
                        <td colspan="5" class="p-8 text-center text-gray-400">Thư mục trống. Hãy tải file lên.</td>
                    </tr>
                    <% } %>

                    <% files.forEach(function(file) { %>
                    <tr class="file-item group">
                        <!-- Icon -->
                        <td class="p-4 text-center text-lg cursor-pointer" onclick="openItem('<%= file.isDirectory %>', '<%= file.name %>')">
                            <% if (file.isDirectory) { %>
                                <i class="fa-solid fa-folder text-yellow-400"></i>
                            <% } else { %>
                                <% if (file.name.match(/\.(jpg|jpeg|png|gif|webp)$/i)) { %>
                                    <i class="fa-solid fa-image text-blue-500"></i>
                                <% } else if (file.name.match(/\.(mp4|webm)$/i)) { %>
                                    <i class="fa-solid fa-video text-red-500"></i>
                                <% } else if (file.name.match(/\.(pdf)$/i)) { %>
                                    <i class="fa-solid fa-file-pdf text-red-600"></i>
                                <% } else { %>
                                    <i class="fa-solid fa-file text-gray-400"></i>
                                <% } %>
                            <% } %>
                        </td>
                        
                        <!-- Name -->
                        <td class="p-4 font-medium text-gray-800 cursor-pointer" onclick="openItem('<%= file.isDirectory %>', '<%= file.name %>')">
                            <%= file.name %>
                        </td>
                        
                        <!-- Size -->
                        <td class="p-4 text-sm text-gray-500 hidden md:table-cell cursor-pointer" onclick="openItem('<%= file.isDirectory %>', '<%= file.name %>')">
                            <% if (!file.isDirectory) { %>
                                <%= (file.size / 1024 / 1024).toFixed(2) %> MB
                            <% } else { %>
                                --
                            <% } %>
                        </td>
                        
                        <!-- Date -->
                        <td class="p-4 text-sm text-gray-500 hidden md:table-cell cursor-pointer" onclick="openItem('<%= file.isDirectory %>', '<%= file.name %>')">
                            <%= new Date(file.modifiedAt).toLocaleDateString('vi-VN') %>
                        </td>
                        
                        <!-- Actions -->
                        <td class="p-4 text-right">
                            <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                <% if (!file.isDirectory) { %>
                                <a href="/explorer/download?file=<%= encodeURIComponent(currentPath === '/' ? '/' + file.name : currentPath + '/' + file.name) %>" class="text-blue-500 hover:text-blue-700 p-2" title="Tải xuống" onclick="event.stopPropagation()">
                                    <i class="fa-solid fa-download"></i>
                                </a>
                                <% } %>
                                
                                <form action="/explorer/delete" method="POST" class="inline" onsubmit="event.stopPropagation(); return confirm('Bạn có chắc chắn muốn xoá <%= file.name %>?')">
                                    <input type="hidden" name="currentPath" value="<%= currentPath %>">
                                    <input type="hidden" name="itemName" value="<%= file.name %>">
                                    <button type="submit" class="text-red-500 hover:text-red-700 p-2" title="Xoá" onclick="event.stopPropagation()">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Media Viewer Modal -->
    <div id="mediaModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 transition-opacity duration-300">
        <div class="relative max-w-5xl w-full max-h-screen flex flex-col items-center justify-center">
            <!-- Close button -->
            <button onclick="closeMedia()" class="absolute top-4 right-4 md:-top-10 md:right-0 text-white hover:text-red-400 text-3xl transition-colors">
                <i class="fa-solid fa-xmark"></i>
            </button>
            
            <!-- Dynamic Content Container -->
            <div id="mediaContainer" class="w-full flex justify-center items-center rounded-lg overflow-hidden shadow-2xl">
                <!-- Image or Video will be injected here -->
            </div>
            
            <!-- File name footer -->
            <div id="mediaFilename" class="text-white/80 mt-4 text-sm font-mono tracking-wider"></div>
        </div>
    </div>

    <script>
        const mediaModal = document.getElementById('mediaModal');
        const mediaContainer = document.getElementById('mediaContainer');
        const mediaFilename = document.getElementById('mediaFilename');
        const loadingOverlay = document.getElementById('loadingOverlay');

        // Show loading when uploading
        document.getElementById('uploadForm').addEventListener('submit', function() {
            loadingOverlay.classList.remove('hidden');
            loadingOverlay.classList.add('flex');
        });

        function closeMedia() {
            mediaModal.classList.remove('opacity-100');
            setTimeout(() => {
                mediaModal.classList.add('hidden');
                mediaContainer.innerHTML = ''; // Clear content to stop video
            }, 300);
        }

        // Close on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !mediaModal.classList.contains('hidden')) {
                closeMedia();
            }
        });

        // Close on clicking backdrop
        mediaModal.addEventListener('click', (e) => {
            if (e.target === mediaModal || e.target.parentElement === mediaModal) {
                closeMedia();
            }
        });

        function openItem(isDir, name) {
            const currentPath = "<%= currentPath %>";
            const newPath = currentPath === '/' ? '/' + name : currentPath + '/' + name;
            
            if (isDir === 'true') {
                window.location.href = '/explorer?path=' + encodeURIComponent(newPath);
            } else {
                const streamUrl = '/explorer/stream?file=' + encodeURIComponent(newPath);
                const downloadUrl = '/explorer/download?file=' + encodeURIComponent(newPath);
                
                const ext = name.split('.').pop().toLowerCase();
                const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg'].includes(ext);
                const isVideo = ['mp4', 'webm', 'ogg', 'mov'].includes(ext);
                
                if (isImage || isVideo) {
                    mediaFilename.textContent = name;
                    
                    if (isImage) {
                        mediaContainer.innerHTML = `<img src="${streamUrl}" class="max-w-full max-h-[85vh] object-contain rounded-lg" alt="${name}">`;
                    } else if (isVideo) {
                        mediaContainer.innerHTML = `<video src="${streamUrl}" controls autoplay class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-black/50 shadow-2xl"></video>`;
                    }
                    
                    mediaModal.classList.remove('hidden');
                    // Small delay to allow display:block to apply before animating opacity
                    setTimeout(() => {
                        mediaModal.classList.add('opacity-100');
                    }, 10);
                } else {
                    // Open file preview/download normally
                    window.open(downloadUrl, '_blank');
                }
            }
        }
    </script>
</body>
</html>
